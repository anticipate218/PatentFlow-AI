{
  "name": "patentflow-ai",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anticipate218/PatentFlow-AI.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test src/*.test.ts server/*.test.ts worker/*.test.ts scripts/*.test.mjs",
    "check:worker": "node -e \"require('node:fs').mkdirSync('.wrangler/types',{recursive:true})\" && wrangler types .wrangler/types/worker-configuration.d.ts && tsc --noEmit -p tsconfig.worker.json",
    "release:scan": "node scripts/release-scan.mjs",
    "release:scan:dist": "node scripts/release-scan.mjs --dist",
    "verify": "npm test && npm run lint && npm run check:worker && npm run build && npm run test:worker:mock && npm run release:scan && npm run release:scan:dist",
    "cf:dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "cf:deploy": "npm run verify && wrangler deploy",
    "cf:secrets": "node scripts/cf-secrets.mjs",
    "test:worker": "node scripts/worker-smoke.mjs",
    "health:online": "node scripts/site-health.mjs",
    "test:worker:mock": "node scripts/worker-check.mjs"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "docx": "^9.13.0",
    "motion": "^14.6.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wrangler": "4.155.0"
  }
}
